OPENAI_API_KEY=replace-with-your-key
OPENAI_BASE_URL=https://your-openai-compatible-endpoint.example/v1
MODEL_NAME=your-tool-calling-model
TASK_API_TOKEN=replace-with-a-long-random-token
# Optional client destination; server does not use this value.
TASK_API_URL=https://webagent.elgrowth.com
REQUIRE_TASK_API_TOKEN=false
ENABLE_WRITE_ACTIONS=false
# Set a generated Fernet key on the server only to accept structured credentials.
CREDENTIAL_FERNET_KEY=
CREDENTIAL_TTL_SECONDS=900
