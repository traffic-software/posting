OPENAI_API_KEY=replace-with-your-key
OPENAI_BASE_URL=https://your-openai-compatible-endpoint.example/v1
MODEL_NAME=your-tool-calling-model
TASK_API_TOKEN=replace-with-a-long-random-token
# Optional client destination; server does not use this value.
TASK_API_URL=https://webagent.elgrowth.com
REQUIRE_TASK_API_TOKEN=false
ENABLE_WRITE_ACTIONS=false
# Recommended on the server for credentials to survive restarts.
# Blank uses private process-local encryption for tests; pending credential tasks fail after restart.
CREDENTIAL_FERNET_KEY=
CREDENTIAL_TTL_SECONDS=900

# Local Chromium/Xvfb runtime paths inside the application container.
# SeleniumBase 4.55.0 normal headed Chrome is the sole backend (no selector/UC/CDP).
# Preflight requires the package driver slot to resolve to this exact driver,
# with matching full browser/driver versions; Docker provisions the root-owned symlink.
# Docker also sets SE_OFFLINE=true and SE_CHROMEDRIVER=/usr/bin/chromedriver
# to prevent Selenium Manager fallback downloads.
# Upstream disables sandbox/TLS certificate checks; enable_ws does not restore them.
# See plan/seleniumbase-migration-plan.md for the accepted security tradeoff.
CHROMIUM_BINARY=/usr/bin/chromium
CHROMEDRIVER_BINARY=/usr/bin/chromedriver
BROWSER_WINDOW_WIDTH=1024
BROWSER_WINDOW_HEIGHT=768

# Browser profiles and desktop control. This token grants privileged account access.
# Separate token, never use the task API token.
DISPLAY_VIEWER_ENABLED=false
DISPLAY_VIEWER_TOKEN=
# Exact browser origin. HTTPS required remotely; HTTP permitted only on loopback.
# Local manual test example: http://127.0.0.1:8001
DISPLAY_VIEWER_ORIGIN=
DISPLAY_VIEWER_SESSION_SECONDS=1800
# Private Linux-native persistent profiles; Compose uses its durable /data volume.
# run-wsl.sh overrides this beneath $HOME/.local/share/posting/manual/profiles.
BROWSER_PROFILES_ROOT=data/browser_profiles
MANUAL_BROWSER_SECONDS=1800
TASK_MANUAL_SECONDS=600
MANUAL_DISCONNECTED_GRACE_SECONDS=60
