
		{
			"version": "1.0.0",
			"manifest_version": 2,
			"name": "Chrome Proxy",
			"declarative_net_request": {
				"rule_resources": [{
				"id": "ruleset_1",
				"enabled": true,
				"path": "rules.json"
				}]
			},
			"permissions": [
				"proxy",
				"tabs",
				"unlimitedStorage",
				"storage",
				"<all_urls>",
				"webRequest",
				"webRequestBlocking",
				"declarativeNetRequest"
			],
			"background": {
				"scripts": ["background.js"]
			},
			"minimum_chrome_version":"22.0.0"
		}
		